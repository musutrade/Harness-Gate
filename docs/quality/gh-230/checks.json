[
  {
    "name": "nextest",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--manifest-path",
      "tools/harness-gate/Cargo.toml",
      "--locked"
    ],
    "exit_code": 100
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--manifest-path",
      "tools/harness-gate/Cargo.toml",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--manifest-path",
      "tools/harness-gate/Cargo.toml",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "quality-tests",
    "command": [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tools/quality/tests",
      "-v"
    ],
    "exit_code": 1
  }
]
