    "text": "struct Step { passed: bool }\nfn field_only(steps: &[Step]) -> bool { steps.iter().all(|step| step.passed) }\nfn method_call(steps: &[String]) -> bool { steps.iter().all(|step| step.is_empty()) }\nfn main() {\n    assert!(field_only(&[Step { passed: true }]));\n    assert!(!field_only(&[Step { passed: false }]));\n    assert!(method_call(&[String::new()]));\n    assert!(!method_call(&[String::from(\"x\")]));\n}\n"
